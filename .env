# External ports
KEYCLOAK_PORT=9090
RULESHAKE_STUDIO_PORT=9000
RULESHAKE_SERVER_PORT=9001

# Versions
RULESHAKE_STUDIO_VERSION=1.7.0
RULESHAKE_SERVER_VERSION=0.1.0

# Postgres (ruleshake-server)
RULESHAKE_DB=ruleshake
RULESHAKE_DB_USER=ruleshake
RULESHAKE_DB_PASSWORD=ruleshake
# basic user of the actuator endpoints (/actuator/**, except the health probes)
RULESHAKE_ACTUATOR_USER=admin
RULESHAKE_ACTUATOR_PASSWORD=admin

# Keycloak
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_RULESHAKE_ORGANIZATION=sample
KEYCLOAK_RULESHAKE_STUDIO_CLIENT_ID=ruleshake-studio
KEYCLOAK_RULESHAKE_STUDIO_CLIENT_SECRET=changeit
KEYCLOAK_AUTHORITY=http://keycloak:${KEYCLOAK_PORT}/realms/ruleshake-${KEYCLOAK_RULESHAKE_ORGANIZATION}
